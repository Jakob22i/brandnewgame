--[[
	King of the Pirates - place builder (run with Lune from the repository root):

		lune run build/build.luau

	1. Opens place/base.rbxl (the original Roblox place)
	2. Sets up lighting, water and world settings for a tropical look
	3. Copies every script from src/ into the place (Rojo-style file names)
	4. Builds ships, tools, chests, enemies, the town of Kingshaven and island nature
	5. Writes KingOfThePirates.rbxl (+ build/sourcemap.json for luau-lsp)

	Terrain is generated by the game itself when the server starts
	(ServerScriptService.Services.TerrainGenerator), from the same Heightmap module
	that is used here to place trees and buildings.
]]
local fs = require("@lune/fs")
local roblox = require("@lune/roblox")
local serde = require("@lune/serde")
local process = require("@lune/process")

local loader = require("./lib/loader")
local P = require("./builders/Parts")
local Ships = require("./builders/Ships")
local Tools = require("./builders/Tools")
local Chests = require("./builders/Chests")
local Rigs = require("./builders/Rigs")
local Town = require("./builders/Town")
local Nature = require("./builders/Nature")
local MainIsland = require("./builders/MainIsland")

local Instance = roblox.Instance
local Enum = roblox.Enum
local V = roblox.Vector3.new
local CF = roblox.CFrame.new
local rgb = P.rgb

local BASE_PLACE = "place/base.rbxl"
local OUTPUT = process.args[1] or "KingOfThePirates.rbxl"
local SRC = "src"

local SHARED = SRC .. "/ReplicatedStorage/Shared/"
local Config = loader.load(SHARED .. "Config.luau")
local World = loader.load(SHARED .. "WorldData.luau")
local Noise = loader.load(SHARED .. "Noise.luau")
local H = loader.load(SHARED .. "Heightmap.luau")

print("Loading " .. BASE_PLACE)
local game = roblox.deserializePlace(fs.readFile(BASE_PLACE))
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")
local StarterPlayer = game:GetService("StarterPlayer")

-- 1. Clean out the template ----------------------------------------------------
for _, name in { "Baseplate", "SpawnLocation" } do
	local inst = Workspace:FindFirstChild(name)
	if inst then
		inst:Destroy()
	end
end

-- 2. World settings -------------------------------------------------------------
Workspace.StreamingEnabled = false
Workspace.FallenPartsDestroyHeight = -400
Players.CharacterAutoLoads = false -- the server spawns players once Kingshaven's terrain exists
StarterPlayer.CameraMaxZoomDistance = 220
StarterPlayer.CharacterWalkSpeed = Config.DefaultWalkSpeed

-- Lighting: a warm but grounded tropical sun. Exposure, bloom, glare and specular are kept low
-- so sand, water and paint read as real materials instead of a shiny holiday brochure.
Lighting.Technology = Enum.Technology.Future
Lighting.Brightness = 2.3
Lighting.Ambient = rgb(70, 66, 64)
Lighting.OutdoorAmbient = rgb(122, 118, 112)
Lighting.ColorShift_Top = rgb(242, 222, 190)
Lighting.ColorShift_Bottom = rgb(0, 0, 0)
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.4
Lighting.ExposureCompensation = -0.2
Lighting.GeographicLatitude = 18
Lighting.ShadowSoftness = 0.35
Lighting.GlobalShadows = true
Lighting.TimeOfDay = "14:00:00"

local function lightingChild(className: string, name: string)
	local inst = Lighting:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Name = name
		inst.Parent = Lighting
	end
	return inst
end

local atmosphere = lightingChild("Atmosphere", "Atmosphere")
atmosphere.Density = 0.34
atmosphere.Offset = 0.12
atmosphere.Color = rgb(196, 208, 210)
atmosphere.Decay = rgb(96, 116, 124)
atmosphere.Glare = 0.05
atmosphere.Haze = 1.7

local bloom = lightingChild("BloomEffect", "Bloom")
bloom.Intensity = 0.12
bloom.Size = 22
bloom.Threshold = 2.4

local sunRays = lightingChild("SunRaysEffect", "SunRays")
sunRays.Intensity = 0.02
sunRays.Spread = 0.55

local dof = lightingChild("DepthOfFieldEffect", "DepthOfField")
dof.Enabled = true
dof.FarIntensity = 0.12
dof.FocusDistance = 120
dof.InFocusRadius = 260
dof.NearIntensity = 0

local cc = lightingChild("ColorCorrectionEffect", "TropicalGrade")
cc.Saturation = 0.02
cc.Contrast = 0.1
cc.Brightness = -0.03
cc.TintColor = rgb(255, 246, 232)

local sky = lightingChild("Sky", "Sky")
sky.SunAngularSize = 11
sky.MoonAngularSize = 9
sky.StarCount = 3000

-- Water
local terrain = Workspace.Terrain
terrain.WaterColor = rgb(24, 124, 134)
terrain.WaterTransparency = 0.45
terrain.WaterReflectance = 0.25
terrain.WaterWaveSize = 0.28
terrain.WaterWaveSpeed = 12
-- No grass blades: the base place had Decoration on with GrassLength 0.7, which covered every
-- Grass voxel in long uniform blades and made the island read like a golf course. The ground
-- now gets its variety from the material mix (leafy floor, warm meadows, dirt, mud, sandstone)
-- and from real plants (ferns, bushes, flowers, palms) placed by the build, as in Sea of Thieves.
terrain.Decoration = false
terrain.GrassLength = 0.3
local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
clouds.Cover = 0.52
clouds.Density = 0.7
clouds.Color = rgb(236, 234, 228)
clouds.Parent = terrain

-- 3. Scripts from src/ -------------------------------------------------------------
local scriptCount = 0
local sourceFiles: { [any]: string } = {}

local function syncDir(dirPath: string, parent: any)
	local entries = fs.readDir(dirPath)
	table.sort(entries)
	for _, entry in entries do
		local full = dirPath .. "/" .. entry
		if fs.isDir(full) then
			local child = parent:FindFirstChild(entry)
			if not child then
				child = Instance.new("Folder")
				child.Name = entry
				child.Parent = parent
			end
			syncDir(full, child)
		elseif string.match(entry, "%.luau$") then
			local name, className
			if string.match(entry, "%.server%.luau$") then
				name, className = string.gsub(entry, "%.server%.luau$", ""), "Script"
			elseif string.match(entry, "%.client%.luau$") then
				name, className = string.gsub(entry, "%.client%.luau$", ""), "LocalScript"
			else
				name, className = string.gsub(entry, "%.luau$", ""), "ModuleScript"
			end
			local existing = parent:FindFirstChild(name)
			if existing then
				existing:Destroy()
			end
			local s = Instance.new(className)
			s.Name = name
			s.Source = fs.readFile(full)
			s.Parent = parent
			sourceFiles[s] = full
			scriptCount += 1
		end
	end
end

for _, serviceName in fs.readDir(SRC) do
	syncDir(SRC .. "/" .. serviceName, game:GetService(serviceName))
end
print(("Synced %d scripts"):format(scriptCount))

-- 4. Remotes ------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
for _, name in {
	"Notify",
	"PlayerData",
	"OpenShop",
	"ShipAction",
	"ShipClient",
	"CombatAction",
	"Fx",
	"TreasureAction",
	"TradeAction",
	"TradeClient",
	"CrewAction",
	"CrewClient",
} do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
end
for _, name in { "ShopRequest" } do
	local r = Instance.new("RemoteFunction")
	r.Name = name
	r.Parent = remotes
end

-- 5. Templates in ServerStorage -------------------------------------------------------
local shipsFolder = P.folder(ServerStorage, "Ships")
for id, def in Config.Ships do
	Ships.Build(id, def).Parent = shipsFolder
end

local toolsFolder = P.folder(ServerStorage, "Tools")
for _, tool in Tools.Build() do
	tool.Parent = toolsFolder
end

local chestFolder = P.folder(ServerStorage, "Chests")
for id, def in Config.Chests do
	Chests.Build(id, def).Parent = chestFolder
end

local enemyFolder = P.folder(ServerStorage, "Enemies")
Rigs.Skeleton().Parent = enemyFolder

-- 6. The world ------------------------------------------------------------------------
for _, name in { "Ships", "Enemies", "Treasure", "Effects" } do
	P.folder(Workspace, name)
end

local town, clear = Town.Build(Workspace, H, World)
local mainIsland, islandStats = MainIsland.Build(Workspace, H, World, Noise, clear)
print(("MainIsland: %d parts (%d cliff rocks)"):format(islandStats.Parts or 0, islandStats.Cliffs or 0))
local nature, stats = Nature.Build(Workspace, H, World, Noise, clear)
print(("Nature: %d palms, %d trees, %d rocks, %d small plants"):format(stats.Palms, stats.Trees, stats.Rocks, stats.Bushes))

local partCount = 0
for _, d in Workspace:GetDescendants() do
	if d:IsA("BasePart") then
		partCount += 1
	end
end
print(("Workspace parts: %d"):format(partCount))

-- 7. Save -------------------------------------------------------------------------------
fs.writeFile(OUTPUT, roblox.serializePlace(game))
print("Wrote " .. OUTPUT)

-- Rojo-style sourcemap so luau-lsp can type-check the scripts against this place
local function mapNode(inst: any)
	local node: { [string]: any } = { name = inst.Name, className = inst.ClassName }
	if sourceFiles[inst] then
		node.filePaths = { sourceFiles[inst] }
	end
	local children = {}
	for _, child in inst:GetChildren() do
		table.insert(children, mapNode(child))
	end
	if #children > 0 then
		node.children = children
	end
	return node
end
local rootNode = { name = "Game", className = "DataModel", children = {} }
for _, serviceName in { "Workspace", "Lighting", "ReplicatedFirst", "ReplicatedStorage", "ServerScriptService", "ServerStorage", "StarterPlayer", "StarterGui", "StarterPack", "Players" } do
	table.insert(rootNode.children, mapNode(game:GetService(serviceName)))
end
fs.writeFile("build/sourcemap.json", serde.encode("json", rootNode, false))
